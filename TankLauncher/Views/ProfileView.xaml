<UserControl x:Class="TankiLauncher.Views.ProfileView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Grid>

<Grid.Background>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#F2E3B6" Offset="0"/>
<GradientStop Color="#E8D39A" Offset="0.5"/>
<GradientStop Color="#D9BC7A" Offset="1"/>
</LinearGradientBrush>
</Grid.Background>

<Border
Background="#AAFFFFFF"
CornerRadius="15"
Padding="25"
Width="420"
HorizontalAlignment="Center"
VerticalAlignment="Center">

<StackPanel>

<TextBlock x:Name="UsernameText"
FontSize="26"
FontWeight="Bold"
HorizontalAlignment="Center"/>

<TextBlock x:Name="RankText"
FontSize="16"
HorizontalAlignment="Center"
Margin="0,0,0,10"/>

<TextBlock Text="Уровень"/>

<ProgressBar x:Name="ExpBar"
Height="20"
Margin="0,5,0,10"/>

<TextBlock x:Name="ExpText"
HorizontalAlignment="Center"/>

<TextBlock Text="Ресурсы"
FontSize="18"
Margin="0,10"/>

<UniformGrid Columns="2">

<TextBlock Text="Серебро:"/>
<TextBlock x:Name="SilverText"/>

<TextBlock Text="Золото:"/>
<TextBlock x:Name="GoldText"/>

<TextBlock Text="Железо:"/>
<TextBlock x:Name="IronText"/>

<TextBlock Text="Медь:"/>
<TextBlock x:Name="CopperText"/>

<TextBlock Text="Титан:"/>
<TextBlock x:Name="TitaniumText"/>

<TextBlock Text="Топливо:"/>
<TextBlock x:Name="FuelText"/>

</UniformGrid>

<TextBlock Text="Статистика"
FontSize="18"
Margin="0,10"/>

<UniformGrid Columns="2">

<TextBlock Text="Бои:"/>
<TextBlock x:Name="BattlesText"/>

<TextBlock Text="Победы:"/>
<TextBlock x:Name="WinsText"/>

<TextBlock Text="K/D:"/>
<TextBlock x:Name="KDText"/>

</UniformGrid>

</StackPanel>

</Border>

</Grid>

</UserControl>
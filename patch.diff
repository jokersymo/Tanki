new file mode 100644
index 0000000000000000000000000000000000000000..ebbd43a215b8acde7f7ca945413355a7a9d8d3b5
--- /dev/null
+++ b/.github/workflows/dotnet.yml
@@ -0,0 +1,24 @@
+name: TankServer Build
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  build:
+
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: 8.0.x
+
+      - name: Restore
+        run: dotnet restore Tanki.sln
+
+      - name: Build
+        run: dotnet build Tanki.sln --no-restore
